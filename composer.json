{
    "name": "laikait/laika-model",
    "description": "A PDO Multi-Connectoion Database Model",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Laika\\Model\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laika\\Model\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit --configuration phpunit.xml.dist --colors=always --testdox"
        ],
        "lint": "php-cs-fixer fix --dry-run --diff",
        "compat": "phpcs --standard=phpcs.xml --report=full"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
